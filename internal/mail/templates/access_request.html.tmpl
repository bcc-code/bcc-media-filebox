{{/*
  Author-facing twin of share_notification.html.tmpl: same shell, same tokens.
  See that file for why the colours are hex and the layout is tables.
*/}}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>{{.RequesterEmail}} asked you to reopen a package</title>
<style>
  :root { color-scheme: dark; supported-color-schemes: dark; }
  a { color: #73a9e1; }
  @media (max-width: 520px) {
    .fb-pad { padding: 24px 20px !important; }
  }
</style>
</head>
<body style="margin:0; padding:0; background-color:#0a1426; -webkit-font-smoothing:antialiased;">
<div style="display:none; max-height:0; overflow:hidden; opacity:0;">{{.ReasonLabel}} — they are asking for access again</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0a1426" style="background-color:#0a1426;">
  <tr>
    <td align="center" style="padding:36px 12px 48px;">

      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0f1c33" style="max-width:480px; background-color:#0f1c33; border:1px solid #2a3d61; border-radius:16px;">
      <tr>
      <td class="fb-pad" style="padding:30px 30px 28px; font-family:'Inter',system-ui,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; color:#e7ecf5;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">

        {{/* .public-brand */}}
        <tr>
          <td style="padding-bottom:22px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0">
              <tr>
                {{if .LogoURL}}
                <td valign="middle" style="padding-right:10px; line-height:0;"><img src="{{.LogoURL}}" width="23" height="26" alt="" style="display:block; border:0; outline:none;"></td>
                {{end}}
                <td valign="middle" style="font-size:16px; font-weight:600; color:#e7ecf5; letter-spacing:-0.1px;">FileBox</td>
              </tr>
            </table>
          </td>
        </tr>

        {{/* .public-from + .public-pkgname */}}
        <tr>
          <td style="font-size:14px; line-height:1.5; color:#aeb8cc;">
            <strong style="color:#e7ecf5; font-weight:600; word-break:break-all;">{{.RequesterEmail}}</strong> asked you to reopen this package
          </td>
        </tr>
        {{if .PackageName}}
        <tr>
          <td style="padding-top:6px; font-size:23px; font-weight:600; letter-spacing:-0.3px; color:#e7ecf5; line-height:1.3;">{{.PackageName}}</td>
        </tr>
        {{end}}

        {{/* .public-msg — the requester's own note */}}
        {{if .Message}}
        <tr>
          <td style="padding-top:16px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0a1426" style="background-color:#0a1426; border:1px solid #1f2f4d; border-radius:10px;">
              <tr><td style="padding:13px 15px; font-size:13.5px; line-height:1.55; color:#aeb8cc;">{{.MessageHTML}}</td></tr>
            </table>
          </td>
        </tr>
        {{end}}

        {{/* .pkg-meta as a key/value list */}}
        <tr>
          <td style="padding-top:20px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td style="padding:9px 0; font-size:12.5px; color:#6c7896;">Why it failed</td>
                <td align="right" style="padding:9px 0 9px 12px; font-size:13px; color:#e7ecf5;">{{.ReasonLabel}}</td>
              </tr>
              <tr>
                <td style="padding:9px 0; font-size:12.5px; color:#6c7896; border-top:1px solid #1f2f4d;">Expiry</td>
                <td align="right" style="padding:9px 0 9px 12px; font-size:13px; color:#e7ecf5; border-top:1px solid #1f2f4d; white-space:nowrap;">{{.ExpiredOn}}</td>
              </tr>
              {{with .LimitLabel}}
              <tr>
                <td style="padding:9px 0; font-size:12.5px; color:#6c7896; border-top:1px solid #1f2f4d;">Downloads</td>
                <td align="right" style="padding:9px 0 9px 12px; font-size:13px; color:#e7ecf5; border-top:1px solid #1f2f4d; font-family:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;">{{.}}</td>
              </tr>
              {{end}}
            </table>
          </td>
        </tr>

        {{/* .btn.btn-primary.btn-block */}}
        <tr>
          <td style="padding-top:22px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td align="center" bgcolor="#73a9e1" style="background-color:#73a9e1; border-radius:9px;">
                  <a href="{{.ManageURL}}" style="display:block; padding:12px 18px; font-family:'Inter',system-ui,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif; font-size:14px; font-weight:600; color:#0a1426; text-decoration:none; border-radius:9px;">Review and extend</a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {{/* .public-note */}}
        <tr>
          <td align="center" style="padding-top:14px; font-size:12px; line-height:1.5; color:#6c7896;">
            Do nothing and the package stays exactly as it is — the link stays closed.
          </td>
        </tr>

        <tr>
          <td style="padding-top:22px; border-top:1px solid #1f2f4d;"></td>
        </tr>
        <tr>
          <td style="font-size:11.5px; line-height:1.6; color:#6c7896; word-break:break-all;">
            If the button doesn't work, open this link:<br>
            <a href="{{.ManageURL}}" style="color:#73a9e1; text-decoration:none;">{{.ManageURL}}</a>
          </td>
        </tr>
        <tr>
          <td style="padding-top:12px; font-size:11.5px; line-height:1.6; color:#6c7896;">
            Sent by FileBox. Reply to this email to reach {{.RequesterEmail}} directly.
          </td>
        </tr>

      </table>
      </td>
      </tr>
      </table>

    </td>
  </tr>
</table>
</body>
</html>
